# Advanced Hangman
# .gitignore

# Python Bytecode
__pycache__/
*.py[cod]
*$py.class

# Python Cache / Runtime Files
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.pyre/
.ruff_cache/
.pytype/
.tox/
.nox/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# IDE / Editor Settings
.vscode/
.idea/
*.swp
*.swo
*~
.vscode-test/

# Visual Studio
.vs/

# Operating System Files
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini

# Coverage Reports
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.pytest_cache/

# Build / Distribution
build/
dist/
downloads/
develop-eggs/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/

*.egg-info/
*.egg
pip-wheel-metadata/

# Python Packaging
pip-log.txt
pip-delete-this-directory.txt
pip-uninstall.log

# Logs
*.log
logs/

# Temporary Files
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig

# Environment Variables / Secrets
.env
.env.*
!.env.example

# Jupyter Notebook
.ipynb_checkpoints/

# PyInstaller
*.manifest
*.spec

# Profiling / Performance
*.prof
*.lprof

# Test Artifacts
.pytest_cache/
.nox/
.tox/
test-results/
junit.xml

# Type Checking
.dmypy.json
dmypy.json
.pyre/

# Ruff / Formatting
.ruff_cache/

# Local Development Data
*.sqlite
*.sqlite3
*.db

# Local Save Data
# Keep the game's save directory structure,
# but do not commit personal save progress.
data/saves/*.json

# Allow a placeholder file to keep the directory in Git
!data/saves/.gitkeep

# Local Statistics Data
# Uncomment if statistics should remain local.
# data/statistics.json

# Generated Documentation / Export Files
docs/_build/
docs/build/
docs/_static/
*.pdf

# Generated Archives
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# OS / File Manager Metadata
.Trashes/
.Spotlight-V100/
.fseventsd/
.AppleDouble
.LSOverride

# Windows Explorer
$RECYCLE.BIN/
*.lnk

# macOS / Linux temporary files
*.swp
*.swo

# VS Code local history
.history/

# Project-specific temporary directories
temp/
tmp/
.cache/

# Secrets / Credentials
*.pem
*.key
*.crt
credentials.json
secrets.json 

